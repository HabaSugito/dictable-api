// Landing page for https://dictable.dev (Cloudflare Workers + static assets): npx wrangler deploy
{
  "name": "dictable-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  // Keep the old *.workers.dev address alive; the worker redirects it to dictable.dev.
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the worker first so non-canonical hostnames are redirected before assets are served.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "dictable.dev", "custom_domain": true },
    { "pattern": "www.dictable.dev", "custom_domain": true }
  ]
}
